{
  "name": "tag-maestro",
  "version": "1.0.7",
  "description": "Local music tags, cover artwork and library management",
  "author": "Tag Maestro",
  "main": "desktop/main.cjs",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:desktop": "tsc --noEmit -p tsconfig.desktop.json && vite build --config vite.desktop.config.ts",
    "build:desktop:icon": "node scripts/build-desktop-icon.mjs",
    "desktop": "pnpm build:desktop && electron .",
    "pack:desktop": "pnpm build:desktop && pnpm build:desktop:icon && electron-builder --config electron-builder.yml --dir --publish never",
    "dist:mac": "pnpm build:desktop && pnpm build:desktop:icon && electron-builder --config electron-builder.yml --mac --arm64 --publish never",
    "dist:win": "pnpm build:desktop && pnpm build:desktop:icon && electron-builder --config electron-builder.yml --win --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "jsmediatags": "^3.9.7",
    "jszip": "^3.10.1",
    "music-metadata": "^11.16.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "taglib-wasm": "^1.5.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "sharp": "0.34.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  }
}
